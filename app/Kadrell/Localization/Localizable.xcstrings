    "%lld Claude-Prozess(e) werden sauber beendet. Laufende Arbeit bricht dabei ab. Die Konversationen bleiben erhalten und werden beim nächsten Start fortgesetzt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Claude-Prozess(e) werden sauber beendet. Laufende Arbeit bricht dabei ab. Die Konversationen bleiben erhalten und werden beim nächsten Start fortgesetzt."
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Claude process will be shut down cleanly. Work in progress is interrupted. The conversations are kept and continue on the next launch."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Claude processes will be shut down cleanly. Work in progress is interrupted. The conversations are kept and continue on the next launch."
                }
              }
            }
          }
        }
      }
    },
