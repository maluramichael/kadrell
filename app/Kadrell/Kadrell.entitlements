<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime (Pflicht für die Notarisierung) sperrt das Mikrofon ohne dieses Entitlement.
	     Claude Code nutzt es in den Terminals für die Spracheingabe. Keine Sandbox: Kadrell startet
	     claude als Kindprozess mit vollem Zugriff auf ~/.claude und die Projektordner. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
