    "%@ zeigt auf diese App. `kadrell help` listet die Befehle. In Sessions dieser App steht der Pfad zusätzlich in $KADRELL.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zeigt auf diese App. `kadrell help` listet die Befehle. In Sessions dieser App steht der Pfad zusätzlich in $KADRELL."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ points to this app. `kadrell help` lists the commands. Sessions in this app also have the path in $KADRELL."
          }
        }
      }
    },
